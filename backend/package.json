{
  "name": "cinemanage-backend",
  "version": "1.0.0",
  "description": "Cinema management API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:fresh": "lsof -ti :5001 | xargs kill -9 2>/dev/null; node --watch src/index.js",
